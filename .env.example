# Golf Strategy Engine — Environment Variables
# Copy this file to .env and fill in your keys before running `npm run dev`

# REQUIRED — Anthropic API key
# Get yours at: https://console.anthropic.com/api-keys
VITE_ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — Google Maps Embed API key
# Enables satellite imagery inline in the Course Map tab
# Get yours at: https://console.cloud.google.com → Maps Embed API
# Cost: ~$2/month at typical usage. Without this key, a Google Maps link is shown instead.
VITE_GOOGLE_MAPS_KEY=AIza...

# OPTIONAL — Daily per-user limit for the AI import endpoint (api/parse-import.js)
# Separate pool from game-plan generation. Set in Vercel project env vars, not .env.
RATE_LIMIT_IMPORT_PER_DAY=10

# OPTIONAL — Model used by the AI import endpoint (cheap, vision-capable)
# Set in Vercel project env vars, not .env.
PARSE_IMPORT_MODEL=claude-haiku-4-5
